{# Charts added to the weekly, monthly, quarterly and yearly report for one user. #}
{% trans_default_domain 'reporting_graphs' %}
{{ encore_entry_link_tags('chart') }}
{{ encore_entry_script_tags('chart') }}
<link rel="stylesheet" href="{{ path('reporting_bundle_asset', { 'name': 'reporting.css', 'v': asset_version }) }}">
<script src="{{ path('reporting_bundle_asset', { 'name': 'reporting.js', 'v': asset_version }) }}"></script>

<div class="btn-group summary-view-switch" role="group" aria-label="{{ 'summary.view.label'|trans }}" data-summary-view-switch hidden>
  {% for link in view_links %}
    <a class="btn" href="{{ link.url }}">{{ link.label|trans }}</a>
  {% endfor %}
</div>

{# Sort buttons for the table's customer and total columns, moved into its header by reporting.js. #}
<div data-summary-sort-buttons hidden>
  <button type="button" class="summary-sort" data-summary-sort="name">
    {{ 'summary.sort.customer'|trans }}
    <i class="summary-sort-icon fas fa-sort" aria-hidden="true"></i>
  </button>
  <button type="button" class="summary-sort" data-summary-sort="total">
    <i class="summary-sort-icon fas fa-sort" aria-hidden="true"></i>
  </button>
</div>

{# JSON_HEX_TAG keeps names such as "<!--<script>" from ending or hiding the script element. #}
<script type="application/json" id="summary-detail-links">{{ detail_links|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>

{% if summary.groups is not empty %}
  <div class="row row-cards mb-3 summary-report-charts" data-summary-move-to="reporting-content">
    {% include '@ReportingGraphs/chart_data.html.twig' %}
    <div class="col-lg-8">
      <div class="card h-100">
        <div class="card-body summary-chart-fill">
          <div class="summary-chart summary-chart-bar">
            <canvas id="summary-bar-chart" aria-label="{{ 'summary.chart.bar'|trans }}" role="img"></canvas>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          {% include '@ReportingGraphs/doughnut_chart.html.twig' with { 'legend': true } %}
        </div>
      </div>
    </div>
  </div>
{% endif %}
